# =============================================
# MedSegAI — Environment Variables
# Ushbu faylni .env ga nusxalang va qiymatlarni to'ldiring
# =============================================

# --- Application ---
APP_NAME=MedSegAI
APP_ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALLOWED_HOSTS=your-domain.com,localhost

# --- Database ---
POSTGRES_USER=medsegai
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=medsegai
DATABASE_URL=postgresql+asyncpg://medsegai:change_this_strong_password@db:5432/medsegai

# --- Redis ---
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-this-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Storage ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=500

# --- AI Model ---
AI_MODEL_PATH=/app/ai_models/best_boundary_attention_unet_v2.pth
AI_MODEL_TYPE=attention_unet
AI_INPUT_SIZE=256
AI_DEVICE=auto

# --- Celery ---
CELERY_BROKER_URL=redis://:change_this_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_this_redis_password@redis:6379/2

# --- Email (optional, for password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@medsegai.com

# --- First Admin User (auto-created on startup) ---
FIRST_ADMIN_EMAIL=admin@medsegai.com
FIRST_ADMIN_PASSWORD=Admin123!@#ChangeThis
FIRST_ADMIN_FULLNAME=System Administrator
