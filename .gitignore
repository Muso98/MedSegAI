# Git ignore
.env
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# AI Models (large files)
ai_models/*.pth
ai_models/*.pt
ai_models/*.bin

