backend/media/
media/
scratch/

# Database
*.db
*.sqlite3

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# SSL certs
nginx/ssl/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
